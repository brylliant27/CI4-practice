#--------------------------------------------------------------------
# Modèle du fichier .env (format CodeIgniter 4). Copier en .env et remplir.
# Le .env n'est JAMAIS commité (exclu par .gitignore) : il contient les secrets.
# Sur Alwaysdata, il s'écrit directement sur le serveur (voir docs/deploiement.md).
#--------------------------------------------------------------------

# production sur Alwaysdata, development en local
CI_ENVIRONMENT = production

app.baseURL = 'https://<compte>.alwaysdata.net/'

# HTTPS obligatoire en production (cookie de session « Secure », cf. Conception RGPD)
app.forceGlobalSecureRequests = true
cookie.secure = true

# Base MySQL/MariaDB d'Alwaysdata (accessible uniquement DEPUIS le serveur)
database.default.hostname = mysql-<compte>.alwaysdata.net
database.default.database = <compte>_sae301
database.default.username = <compte>
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

# Clé Open-Meteo fournie sur Moodle (facultative : sans clé, API gratuite limitée par IP)
OPENMETEO_API_KEY =

# Commande Python du module de calcul DATA.
# Sur Alwaysdata : chemin absolu donné par « command -v python » en SSH.
calcul.python = python

# Windows uniquement (WampServer), si l'API répond « SSL certificate problem » :
# CURL_CA_BUNDLE = C:/Program Files/Git/mingw64/etc/ssl/certs/ca-bundle.crt
